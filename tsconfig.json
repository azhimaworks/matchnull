{
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
    },
    "rootDir": "./src",
    "outDir": "./dist",

    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "types": ["types-for-adobe/AfterEffects/24.6"],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
  },
}
